# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE READINESS (Optional — app defaults to in-memory Mock Data Service when VITE_USE_SUPABASE="false")
# Set VITE_USE_SUPABASE="true" and provide your Supabase project URL and Anon Key to switch dataService to Supabase.
VITE_USE_SUPABASE="false"
VITE_SUPABASE_URL="https://hborsauwmbtpdcwysyfk.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_upxaurm4GbEwWi11fpE-4w_aESC1tDe"


# Optional Edge Function ("assistant-llm") toggle for APAAR Ready Assistant.
# Off by default ("false"); assistant runs 100% offline from the built-in knowledge base.
VITE_ENABLE_ASSISTANT_LLM="false"
